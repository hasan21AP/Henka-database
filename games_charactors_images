import os
import re
import time
import requests

IMAGES_DIR = "game_characters_images"
API_URL = "https://assassinscreed.fandom.com/api.php"

os.makedirs(IMAGES_DIR, exist_ok=True)

HEADERS = {
    "User-Agent": "HenkaGame/1.0",
    "Accept": "application/json"
}

CHARACTERS = [
    "Altaïr Ibn-La'Ahad",
    "Ezio Auditore da Firenze",
    "Desmond Miles",
    "Edward Kenway",
    "Connor Kenway",
    "Haytham Kenway",
    "Arno Dorian",
    "Jacob Frye",
    "Evie Frye",
    "Bayek",
    "Aya",
    "Kassandra",
    "Alexios",
    "Eivor Varinsdottir",
    "Basim Ibn Ishaq",
    "Shay Cormac",
    "Aveline de Grandpré",
    "Lucy Stillman",
    "Rebecca Crane",
    "Shaun Hastings",
]


def safe_filename(name):
    name = name.lower().strip()
    name = re.sub(r"[^a-z0-9]+", "_", name)
    return name.strip("_") + ".jpg"


def search_page_title(name):
    params = {
        "action": "query",
        "list": "search",
        "srsearch": name,
        "srlimit": 1,
        "format": "json"
    }

    response = requests.get(API_URL, params=params, headers=HEADERS, timeout=30)
    response.raise_for_status()

    results = response.json().get("query", {}).get("search", [])

    if not results:
        return None

    return results[0]["title"]


def get_page_images(title):
    params = {
        "action": "query",
        "prop": "images",
        "titles": title,
        "imlimit": "100",
        "format": "json"
    }

    response = requests.get(API_URL, params=params, headers=HEADERS, timeout=30)
    response.raise_for_status()

    pages = response.json().get("query", {}).get("pages", {})

    image_titles = []

    for page in pages.values():
        for img in page.get("images", []):
            image_titles.append(img["title"])

    return image_titles


def choose_best_image(image_titles, character_name):
    good_words = [
        "render", "renders", "full_body", "full-body", "fullbody",
        "portrait", "profile", "character", "standing",
        "outfit", "model", "transparent", "png"
    ]

    bad_words = [
        "icon", "map", "logo", "symbol", "flag", "weapon",
        "location", "emblem", "banner", "concept", "screenshot",
        "codex", "database", "achievement", "trophy", "comic",
        "memory", "cutscene", "trailer", "wallpaper", "poster",
        "scene", "dead", "corpse", "animus", "glyph", "letter",
        "document", "painting", "mural", "room", "building"
    ]

    character_parts = re.findall(r"[a-zA-Z]+", character_name.lower())

    candidates = []

    for image_title in image_titles:
        lower = image_title.lower()

        if not lower.endswith((".jpg", ".jpeg", ".png", ".webp")):
            continue

        if any(bad in lower for bad in bad_words):
            continue

        score = 0

        # اسم الشخصية في اسم الصورة
        for part in character_parts:
            if len(part) > 2 and part in lower:
                score += 10

        # كلمات تدل أنها صورة تعريفية للشخصية
        for word in good_words:
            if word in lower:
                score += 8

        # تفضيل PNG غالبًا يكون render بخلفية نظيفة
        if lower.endswith(".png"):
            score += 6

        # تقليل الصور العامة
        if "file:" in lower:
            score += 1

        candidates.append((score, image_title))

    if not candidates:
        return None

    candidates.sort(reverse=True)
    return candidates[0][1]


def get_image_url(image_title):
    params = {
        "action": "query",
        "prop": "imageinfo",
        "titles": image_title,
        "iiprop": "url|size",
        "format": "json"
    }

    response = requests.get(API_URL, params=params, headers=HEADERS, timeout=30)
    response.raise_for_status()

    pages = response.json().get("query", {}).get("pages", {})

    for page in pages.values():
        infos = page.get("imageinfo", [])
        if infos:
            info = infos[0]

            width = info.get("width", 0)
            height = info.get("height", 0)

            if width < 250 or height < 250:
                return None

            return info["url"]

    return None


def download_image(image_url, save_path):
    response = requests.get(
        image_url,
        headers={
            "User-Agent": "HenkaGame/1.0",
            "Referer": "https://assassinscreed.fandom.com/"
        },
        timeout=30
    )

    response.raise_for_status()

    if len(response.content) < 25_000:
        raise Exception("Image too small")

    with open(save_path, "wb") as file:
        file.write(response.content)


downloaded = 0
failed = []

for character in CHARACTERS:
    filename = safe_filename(character)
    save_path = os.path.join(IMAGES_DIR, filename)

    if os.path.exists(save_path):
        print(f"Skipped existing: {filename}")
        continue

    try:
        page_title = search_page_title(character)

        if not page_title:
            print(f"No page: {character}")
            failed.append(character)
            continue

        image_titles = get_page_images(page_title)

        best_image_title = choose_best_image(image_titles, character)

        if not best_image_title:
            print(f"No suitable image: {character}")
            failed.append(character)
            continue

        image_url = get_image_url(best_image_title)

        if not image_url:
            print(f"No valid image URL: {character}")
            failed.append(character)
            continue

        download_image(image_url, save_path)

        downloaded += 1
        print(f"Downloaded {downloaded}: {filename} | {best_image_title}")

        time.sleep(2)

    except Exception as error:
        print(f"Failed: {character} -> {error}")
        failed.append(character)
        time.sleep(3)


print("\nDone!")
print(f"Downloaded: {downloaded}")
print(f"Images folder: {IMAGES_DIR}")

if failed:
    print("\nFailed:")
    for item in failed:
        print("-", item)